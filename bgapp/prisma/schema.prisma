datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

model Game {
  id            Int       @id @default(autoincrement())
  /// Unique when set, enforced by a partial unique index (migration
  /// 20260901000000_unique_bggid); NULL bggId (manual games) may repeat.
  bggId         Int?
  /// BGG's collection-entry id; the handle needed to write status back.
  bggCollId     Int?
  name          String
  type          String    @default("Base")
  cost          Float?
  salePrice     Float?
  status        String    @default("InCollezione")
  /// How the winner of a play is decided: high|low (auto from scores),
  /// coop (shared win/loss), manual (tick winners by hand). See lib/winner.ts.
  winMode       String    @default("high")
  insert        String    @default("No")
  sleeves       String    @default("No")
  sleeveData    String    @default("[]") // TODO: remove after migrazione dati
  purchaseDate  DateTime?
  saleDate      DateTime?
  thumbnail     String?
  image         String?
  description   String?
  designers     String    @default("[]")
  bggRating     Float?
  bggWeight     Float?
  minPlayers    Int?
  maxPlayers    Int?
  playTime      Int?
  yearPublished Int?
  mechanics     String    @default("[]")
  notes         String?
  bggEnrichedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  gameSleeves   GameSleeve[]
  loans         Loan[]
  plays         Play[]

  @@index([bggId])
  @@index([status])
}

model WishlistGame {
  id            Int      @id @default(autoincrement())
  /// Unique when set, enforced by a partial unique index (migration
  /// 20260901000000_unique_bggid); NULL bggId (manual games) may repeat.
  bggId         Int?
  name          String
  type          String   @default("Base")
  valueRange    String?
  desirability  Int      @default(3)
  status        String?
  insert        String   @default("No")
  sleeves       String   @default("No")
  sleeveData    String   @default("[]")
  thumbnail     String?
  image         String?
  description   String?
  designers     String   @default("[]")
  bggRating     Float?
  bggWeight     Float?
  minPlayers    Int?
  maxPlayers    Int?
  playTime      Int?
  yearPublished Int?
  mechanics     String   @default("[]")
  notes         String?
  bggEnrichedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Sleeve {
  id        Int      @id @default(autoincrement())
  size      String
  label     String?
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  games     GameSleeve[]
}

model Loan {
  id         Int       @id @default(autoincrement())
  gameId     Int
  game       Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  borrower   String
  loanDate   DateTime  @default(now())
  returnDate DateTime?
  returned   Boolean   @default(false)
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([gameId])
}

model GameSleeve {
  id        Int      @id @default(autoincrement())
  game      Game     @relation(fields: [gameId], references: [id])
  gameId    Int
  sleeve    Sleeve   @relation(fields: [sleeveId], references: [id])
  sleeveId  Int
  qty       Int      @default(1)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gameId])
  @@index([sleeveId])
}

model Play {
  id         Int      @id @default(autoincrement())
  bggPlayId  Int?     @unique
  date       DateTime
  quantity   Int      @default(1)
  duration   Int?
  location   String?
  notes      String?
  incomplete Boolean  @default(false)
  gameName   String
  bggGameId  Int?
  gameId     Int?
  game       Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)
  players    String?
  createdAt  DateTime @default(now())

  @@index([date])
  @@index([gameId])
  @@index([bggGameId])
}

/// Registry of people you play with, so plays can be logged by picking a name
/// instead of retyping it. Play.players stays the BGG-authoritative record;
/// this table only backs the picker and the avatars.
model Player {
  id             Int       @id @default(autoincrement())
  name           String    @unique
  bggUsername    String?
  avatarUrl      String?
  avatarCheckedAt DateTime?
  playCount      Int       @default(0)
  /// Other spellings this person appears under in play history. Merging folds
  /// a duplicate's name in here so the rebuild can't recreate it from BGG.
  aliases        String    @default("[]")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Places you play at. Like Player, this only backs the picker — Play.location
/// stays the plain string BGG round-trips.
model Place {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  imageUrl  String?
  playCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id              Int       @id @default(autoincrement())
  bggUsername     String?
  bggPassword     String?
  /// Session cookie pasted from a logged-in browser. BGG's login endpoints are
  /// Cloudflare-challenged (no server-to-server login), but the write endpoints
  /// aren't — so writes use this cookie directly. Falls back to login otherwise.
  bggCookie       String?
  autoSyncOnStart Boolean   @default(true)
  lastSyncAt      DateTime?
  /// JSON array of status definitions (label/color/BGG-flag mapping). Null = use
  /// the built-in defaults from lib/status.ts. See StatusDef there.
  statusConfig    String?
}
